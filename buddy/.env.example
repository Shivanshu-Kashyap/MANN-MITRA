# Buddy RAG Service Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# MongoDB (same as Node.js server)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# Google Gemini (for LLM; embeddings optional — see EMBEDDING_BACKEND)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001

# OpenRouter — used if Gemini fails (429/quota) or clear GEMINI_API_KEY to use only OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# (alias) OPEN_ROUTER_API_KEY=sk-or-v1-...
# Base URL only (no /chat/completions). Wrong values cause 404.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model id from https://openrouter.ai/models — default in code: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional (recommended by OpenRouter)
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Mann-Mitra Buddy
# auto = Gemini embeddings if GEMINI_API_KEY set, else local. Use "local" for fast seeding (no API limits).
EMBEDDING_BACKEND=local

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=mental_health_kb

# Node.js Server Connection (for crisis alerts via API)
NODE_SERVER_URL=http://localhost:5000

# Risk Detection Thresholds
RISK_THRESHOLD_MEDIUM=31
RISK_THRESHOLD_HIGH=61
RISK_THRESHOLD_CRITICAL=81

# Conversation
MAX_HISTORY_LENGTH=20
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
