# Buddy RAG Service Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# MongoDB (same as Node.js server)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# Google Gemini (for LLM; embeddings optional — see EMBEDDING_BACKEND)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
# auto = Gemini embeddings if GEMINI_API_KEY set, else local. Use "local" for fast seeding (no API limits).
EMBEDDING_BACKEND=local

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=mental_health_kb

# Node.js Server Connection (for crisis alerts via API)
NODE_SERVER_URL=http://localhost:5000

# Risk Detection Thresholds
RISK_THRESHOLD_MEDIUM=31
RISK_THRESHOLD_HIGH=61
RISK_THRESHOLD_CRITICAL=81

# Conversation
MAX_HISTORY_LENGTH=20
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
