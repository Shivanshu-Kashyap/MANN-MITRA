# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=5000

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/your-database-name

# Client Configuration
CLIENT_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRE=7

# Encryption Configuration (for private notes)
ENCRYPTION_KEY=your-256-bit-encryption-key-as-64-character-hex-string-here

# LLM / REST API (optional – one of OpenAI, Azure, Ollama, or Hugging Face)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-3.5-turbo
# AZURE_OPENAI_ENDPOINT=your-azure-endpoint
# AZURE_OPENAI_KEY=your-azure-key
# AZURE_DEPLOYMENT_NAME=gpt-35-turbo
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=llama2:7b-chat
# HUGGINGFACE_API_KEY=your-huggingface-key
# HUGGINGFACE_MODEL=microsoft/DialoGPT-large